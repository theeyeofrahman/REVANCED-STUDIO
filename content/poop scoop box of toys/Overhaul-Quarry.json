      },
      "Spawned": [
        "Powderline, Field lead, reporting from the cut stone pits and freight lifts."
      ],
      "WakeUp": [
        "Eyes up. Red Quarry Combine still has work to finish."
      ],
      "Attacking": [
        "Powderline taking the field lead lane. no one works a blast alone."
      ],
      "Chasing": [
        "Keep my signal. I'm pushing them toward the the cut stone pits and freight lifts."
      ],
      "Waiting": [
        "Holding position. Check your route before you move."
      ],
      "FriendDied": [
        "We lost one of ours. Mark the spot; the rest of us keep moving."
      ],
      "EnemyDown": [
        "Powderline confirms one hostile down. Watch the next angle."
      ],
      "Wounded": [
        "Powderline is hit! Still moving; get me behind cover!"
      ],
      "Died": [
        "Tell the crew I made it this far with them."
      ],
